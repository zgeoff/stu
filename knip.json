{
  "$schema": "./node_modules/knip/schema.json",
  // the shared oxlint config loads the plugin, and the chex baseline runs diet, so knip never sees either
  "ignoreDependencies": ["@stylistic/eslint-plugin", "@zgeoff/diet"],
  // the test script names its roots, so knip reads no package's tests from it
  "workspaces": {
    // the agent hooks run start.ts from .claude/settings.json and .codex/hooks.json, which knip
    // never reads
    // the verify / gate workflow runs its step script through the root ci:verify-gate script
    ".": { "entry": ["rig.config.ts", ".claude/hooks/start.ts", "scripts/verify-gate/*.test.ts"] },
    // the systemd unit runs the watcher's entry point by its path
    "apps/watch": { "entry": ["src/main.ts", "src/**/*.test.ts"] },
    // wringer runs the launcher by its path, from the local target's launch plan
    "apps/verify": { "entry": ["src/daemon/run-local-daemon.ts", "src/**/*.test.ts"] },
    "{apps,modules,adapters,libs}/*": {
      "entry": ["src/**/*.test.ts", "e2e/**/*.test.ts", "bench/*.bench.ts"]
    }
  }
}
