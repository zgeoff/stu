{
  "name": "stu",
  "private": true,
  "description": "What stu needs to run the owner's conversation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/stu.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "modules/*",
      "adapters/*",
      "libs/*"
    ],
    "catalog": {
      "@atcx/contract": "7.17.0",
      "@commitlint/cli": "21.2.4",
      "@orpc/client": "1.16.1",
      "@orpc/contract": "1.16.1",
      "@orpc/standard-server": "1.16.1",
      "@orpc/standard-server-peer": "1.16.1",
      "@stylistic/eslint-plugin": "5.10.0",
      "@tsconfig/strictest": "2.0.8",
      "@types/bun": "1.4.4",
      "@zgeoff/agent-hooks": "0.2.12",
      "@zgeoff/bun-test-extended": "0.2.3",
      "@zgeoff/chex": "0.3.6",
      "@zgeoff/commitlint-config": "0.1.0",
      "@zgeoff/diet": "0.2.2",
      "@zgeoff/format-codemod": "0.3.5",
      "@zgeoff/oxfmt-config": "0.1.0",
      "@zgeoff/oxlint-config": "0.10.7",
      "@zgeoff/rig": "0.2.4",
      "@zgeoff/testing": "0.3.0",
      "knip": "6.44.2",
      "lefthook": "2.2.2",
      "oxfmt": "0.77.0",
      "oxlint": "1.92.0",
      "tiny-invariant": "1.3.3",
      "ts-pattern": "5.9.2",
      "tsrs": "0.25.0-ts7.1.0-beta",
      "turbo": "2.11.10",
      "typescript": "7.0.2",
      "zod": "4.6.7"
    }
  },
  "type": "module",
  "scripts": {
    "audit": "bun audit --ignore=GHSA-g3hv-75wg-m249",
    "boundaries": "turbo boundaries",
    "deadcode": "bash scripts/run-knip.sh",
    "format": "oxfmt . && { [ -z \"$(git ls-files -co --exclude-standard -- '*.ts' '*.tsx' $(sed -e '/^#/d' -e '/^$/d' -e 's/^/:(exclude,glob)/' .formatignore))\" ] || format-codemod --quiet .; }",
    "format:check": "oxfmt --check . && { [ -z \"$(git ls-files -co --exclude-standard -- '*.ts' '*.tsx' $(sed -e '/^#/d' -e '/^$/d' -e 's/^/:(exclude,glob)/' .formatignore))\" ] || format-codemod --check --quiet .; }",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:full": "TSRS_FAST=1 oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true",
    "prose": "chex prose AGENTS.md",
    "test": "rig unit",
    "test:related": "rig related",
    "typecheck": "tsrs --fast --noEmit && turbo run typecheck",
    "check:commits": "chex commits",
    "check:local-paths": "chex local-paths",
    "check:docs": "chex prose length links readmes skill",
    "check:test-layout": "chex test-layout",
    "check:test-timeouts": "chex test-timeouts",
    "check:dependency-gates": "chex dependency-gates",
    "check:workflows": "chex workflows",
    "check:uncommitted": "chex uncommitted"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@stylistic/eslint-plugin": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@types/bun": "catalog:",
    "@zgeoff/agent-hooks": "catalog:",
    "@zgeoff/bun-test-extended": "catalog:",
    "@zgeoff/chex": "catalog:",
    "@zgeoff/commitlint-config": "catalog:",
    "@zgeoff/diet": "catalog:",
    "@zgeoff/format-codemod": "catalog:",
    "@zgeoff/oxfmt-config": "catalog:",
    "@zgeoff/oxlint-config": "catalog:",
    "@zgeoff/rig": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4"
}
